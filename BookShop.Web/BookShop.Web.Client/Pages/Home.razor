@page "/{categoryId:int?}"
@using BookShop.Transfer.Enums
@using BookShop.Web.Client.Components
@using BookShop.Web.Client.Models

<PageTitle>Home</PageTitle>

<div class="row">
    <div class="col-md-3">
        <CategoryList />
    </div>

